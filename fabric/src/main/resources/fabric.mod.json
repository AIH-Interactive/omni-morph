{
  "schemaVersion": 1,
  "id": "omni-morph",
  "version": "${version}",
  "name": "OmniMorph",
  "description": "Unified Figura Avatar and YSM models with linked Lua and Molang runtimes",
  "authors": [
    "AIH-Interactive",
    "skyrina",
    "lumelia",
    "UnlikePaladin",
    "omoflop"
  ],
  "contributors": [
    "TooManyLimits",
    "Lexize",
    "KitCat962",
    "Manuel-3",
    "superpowers04",
    "auriafoxgirl",
    "applejuiceyy"
  ],
  "contact": {
    "homepage": "https://github.com/AIH-Interactive/omni-morph",
    "issues": "https://github.com/AIH-Interactive/omni-morph/issues",
    "sources": "https://github.com/AIH-Interactive/omni-morph"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "icon": "assets/omni-morph/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "top.aihmc.omnimorph.fabric.FiguraModFabric"
    ],
    "lambdynlights:initializer": [
      "top.aihmc.omnimorph.compat.LambDynamicLightsCompat"
    ]
  },
  "mixins": [
    "omni-morph.mixins.json",
    "omni-morph-common.mixins.json"
  ],
  "depends": {
    "java": ">=${java_version}",
    "minecraft": ">=${minecraft_version}",
    "fabricloader": ">=0.15"
  },
  "conflicts": {
    "immersive_portals": "*",
    "canvas": "*",
    "immediatelyfast": "*"
  },
  "custom": {
    "assets_version": "${assets_version}",
    "modmenu": {
      "links": {
        "GitHub": "https://github.com/AIH-Interactive"
      }
    }
  }
}
